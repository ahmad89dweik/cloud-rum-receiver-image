# Required - the app will not start without this
GCP_PROJECT=streaming-pipeline-learn

# Identity
SERVICE_NAME=exposure-receiver
ENVIRONMENT=local

# Server
PORT=8080
LOG_LEVEL=DEBUG

# Request admission
MAX_BODY_BYTES=64000

# Pub/Sub
PUBSUB_TOPIC=exposures
PUBLISH_TIMEOUT_SECONDS=5.0
PUBLISH_MAX_MESSAGES=100
PUBLISH_MAX_BYTES=1000000
PUBLISH_MAX_LATENCY=0.05
